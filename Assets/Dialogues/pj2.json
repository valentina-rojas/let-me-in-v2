{"inkVersion":21,"root":[[{"->":"introduccion"},["done",{"#f":5,"#n":"g-0"}],null],"done",{"introduccion":[["^Estaba en un refugio cercano, pero me echaron porque había escasez de comida.","\n","ev","str","^¿Estuvo en contacto con otra gente?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^¿Por qué la echaron exactamente?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"contactoRefugio"},{"#f":5}],"c-1":["\n",{"->":"motivoEcharon"},"end",{"#f":5}]}],{"#f":1}],"contactoRefugio":[["^Solamente con la gente del refugio, estaban todos sanos.","\n","ev","str","^¿Presentó síntomas como picazón o sarpullido?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^¿El refugio tenía controles médicos?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"sintomas"},{"#f":5}],"c-1":["\n","^Sí, los hacían cada semana, nadie salió enfermo.","\n","end","end",{"#f":5}]}],{"#f":1}],"sintomas":[["^No, no, me siento perfectamente.","\n","ev","str","^¿Entonces qué son las manchas que tiene en la cara?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Bien, si dice que está sana, confío en su palabra.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"manchas"},{"#f":5}],"c-1":["\n","^Gracias... no todos los guardias son tan comprensivos.","\n","end","end",{"#f":5}]}],{"#f":1}],"manchas":[["^Acné, lo tengo desde los 15 años, ya intenté de todo.","\n","ev","str","^No seré dermatólogo, pero esas ronchas no parecen acné…","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Está bien, quizás me equivoqué.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^¿Qué podés saber vos entonces? Ya te dije que estoy sana, vengo de una zona segura.","\n","end",{"#f":5}],"c-1":["\n","^Gracias... no todos los guardias son tan comprensivos.","\n","end","end",{"#f":5}]}],{"#f":1}],"motivoEcharon":[["^Había muy poca comida, empezaron a elegir quién se quedaba y quién no.","\n","ev","str","^¿Entonces convivió con otros hasta hace poco?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^¿Cómo puedo confiar en su palabra?","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"convivencia"},{"#f":5}],"c-1":["\n","^Porque no tengo motivos para mentir. Solo quiero entrar.","\n","end","end",{"#f":5}]}],{"#f":1}],"convivencia":[["^Sí, pero estaban todos bien.","\n","ev","str","^¿Y esas manchas?","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Está bien, puede ser solo acné.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n",{"->":"manchasMotivo"},{"#f":5}],"c-1":["\n","^En serio, no estoy enferma.","\n","end","end",{"#f":5}]}],{"#f":1}],"manchasMotivo":[["^Acné, nada más.","\n","ev","str","^No estoy tan seguro… parecen infección.","/str","/ev",{"*":".^.c-0","flg":4},"ev","str","^Está bien, puede ser solo acné.","/str","/ev",{"*":".^.c-1","flg":4},{"c-0":["\n","^¿Y vos qué sabés? No soy ningún bicho raro.","\n","end",{"#f":5}],"c-1":["\n","^En serio, no estoy enferma.","\n","end","end",{"#f":5}]}],{"#f":1}],"respuestaIngreso":["^¿En serio? Bueno... gracias.","\n","end",{"#f":1}],"respuestaRechazo":["^Ojalá te echen del laburo...","\n","end",{"#f":1}],"#f":1}],"listDefs":{}}